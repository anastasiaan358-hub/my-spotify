# Прод. Скопируйте в .env НА ПРОД-МАШИНЕ и заполните. В git не попадает.
# Это не тот же файл, что у разработчиков: секреты прода не должны совпадать
# с локальными ни одним значением.

# Обязательные: base.py требует их без дефолтов и упадёт без них
SECRET_KEY=
# Домен, по которому приложение отвечает снаружи, через запятую
ALLOWED_HOSTS=

# Число доверенных прокси перед приложением. За туннелем — 1: от этого зависит,
# какой IP берётся из X-Forwarded-For для rate limiting
NUM_PROXIES=1

# Пароль должен совпадать в обеих строках: первую читает Django, вторую —
# контейнер Postgres при первой инициализации тома
DATABASE_URL=postgres://myspotify:CHANGE_ME@db:5432/myspotify
POSTGRES_PASSWORD=CHANGE_ME

REDIS_CACHE_URL=redis://redis-cache:6379/0
REDIS_QUEUE_URL=redis://redis-queue:6379/0

# Origin'ы веб-клиента через запятую. Пусто = кросс-доменные запросы запрещены
CORS_ALLOWED_ORIGINS=

# MinIO вместо R2 на первом этапе. Пароль не короче 8 символов
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME

# Что разворачивать. Тег :latest удобен, но неотличим между деплоями —
# для воспроизводимости лучше пин на конкретный коммит: ...:sha-<sha>
APP_IMAGE=ghcr.io/lokehoke/my-spotify:latest
