# Скопируйте в .env и заполните. Реальный .env в git не попадает.
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Число доверенных прокси перед приложением (0 — если смотрит в интернет напрямую).
# От него зависит, какой IP берётся из X-Forwarded-For для rate limiting.
NUM_PROXIES=1

DATABASE_URL=postgres://myspotify:myspotify@db:5432/myspotify
POSTGRES_PASSWORD=myspotify

REDIS_CACHE_URL=redis://redis-cache:6379/0
REDIS_QUEUE_URL=redis://redis-queue:6379/0

# Прод: список origin'ов веб-клиента через запятую (в dev разрешены все)
CORS_ALLOWED_ORIGINS=
# Базовый URL веб-клиента — из него собираются ссылки в письмах
FRONTEND_URL=http://localhost:5173

# Почта (в dev письма печатаются в консоль)
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Telegram-бот текстового поиска музыки. Токен выдаёт @BotFather.
TELEGRAM_BOT_TOKEN=
# Числовой Telegram ID единственного владельца. Обязателен.
ADMIN_ID=
# Токен VKpyMusic. Если пусто, шаг VK пропускается.
VK_TOKEN=
VK_USER_AGENT=VKAndroidApp/8.82-19243 (Android 14; SDK 34; arm64-v8a)
BOT_DATABASE_PATH=data/music_cache.sqlite3
MUSIC_SEARCH_PROVIDERS=vk,youtube,soundcloud
TELEGRAM_MAX_AUDIO_MB=49
MUSIC_MAX_DURATION_SECONDS=1200
TELEGRAM_MAX_CONCURRENT_DOWNLOADS=1
